# 复制为 .env 后填写(或直接设环境变量;环境变量优先)。只填你自己的 key,不要提交 .env。

# 【必需】OpenAI 兼容接口地址,写到 /v1 为止。任一兼容服务均可:OpenAI https://platform.openai.com/api-keys ,DeepSeek https://platform.deepseek.com ,或本地 vLLM/Ollama
LLM_BASE_URL=
# 【必需】模型名,选便宜快的(一次调研约 300–600 次调用)
LLM_MODEL=
# 【必需,本地无鉴权服务可留空】接口 key,在上面的服务商控制台申请
LLM_API_KEY=
# 【可选】透传给接口的额外 JSON 字段,如关闭思考 {"reasoning_effort":"none"}
LLM_EXTRA_BODY=
# 【可选】大模型并发上限,默认 16,按你的接口限流调
LLM_CONCURRENCY=

# 【可选,强烈建议】谷歌学术种子(经 Serper),多个用逗号分隔;申请 https://serper.dev
SERPER_API_KEY=
# 【可选】OpenAlex key,多个用逗号分隔;申请 https://openalex.org/settings/api
OPENALEX_API_KEY=
# 【可选】OpenAlex 礼貌池邮箱(你自己的邮箱),无需申请
OPENALEX_MAILTO=
# 【可选】Semantic Scholar key,放宽限流;申请 https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=

# 【可选】中科院分区表 CSV 的本地路径(用户自备;本包不分发,表头见 AGENTS.md)
CAS_TABLE_CSV=
# 【可选】批量下载命令模板,{input}=DOI/链接/题名,{out}=该篇目录;推荐开源工具 paper-download,例:
#   具体命令按 paper-download 的 AGENTS.md 填;要求:rc=0 且在 {out} 里留下 PDF 才算成功
PAPER_DOWNLOAD_CMD=
